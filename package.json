{
  "name": "treehouse-therapy-theme",
  "version": "1.0.0",
  "description": "Premium WordPress theme for Treehouse Therapy Center",
  "scripts": {
    "dev": "npx tailwindcss -i ./assets/css/tailwind.css -o ./dist/css/style.min.css --watch",
    "build": "npx tailwindcss -i ./assets/css/tailwind.css -o ./dist/css/style.min.css --minify",
    "build:js": "cat assets/js/*.js > dist/js/main.min.js"
  },
  "keywords": ["wordpress", "theme", "tailwind", "aba", "therapy"],
  "author": "Treehouse Therapy Center LLC",
  "license": "Proprietary",
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  }
}
